# Copy this file to .env and fill in what you use. .env is never committed to git.

# --- Real footage (free keys, both licensed for commercial use) -------------------------
# https://www.pexels.com/api/   (sign up -> "Your API key")
PEXELS_API_KEY=
# https://pixabay.com/api/docs/ (log in -> your key is shown on that page)
PIXABAY_API_KEY=

# footage = real stock video, 3d = Blender animation (falls back to 3d until a footage key is set)
VIDEO_STYLE=footage

# upload every finished video automatically (youtube, facebook, tiktok). Empty = only with --upload
AUTO_UPLOAD=

# --- YouTube ---------------------------------------------------------------------------
# public | unlisted | private
YOUTUBE_PRIVACY=public
# 27 = Education, 22 = People & Blogs
YOUTUBE_CATEGORY=27

# --- Facebook Page ---------------------------------------------------------------------
FACEBOOK_APP_ID=1719080762768090
FACEBOOK_APP_SECRET=bd4f227aa57f659ff8c374715a01dcd7
# optional: which page to use if you manage several
FACEBOOK_PAGE_ID=61585917899015
FACEBOOK_GRAPH_VERSION=v23.0

# --- TikTok ----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# must be added exactly like this in your TikTok app's Login Kit settings
TIKTOK_REDIRECT_URI=http://localhost:8723/callback/
# direct = post straight to your profile, draft = send to your TikTok inbox to post from the app
TIKTOK_MODE=direct
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
